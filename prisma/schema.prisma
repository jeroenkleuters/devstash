// Prisma 7: the client is generated as TypeScript into the app source tree and
// the connection URL lives in prisma.config.ts, not in the datasource block.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth v5 / Auth.js Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain ----------

enum ContentType {
  TEXT
  URL
  FILE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts

  isPro                Boolean @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Monaco settings, shaped by `editorPreferencesSchema`. Json rather than
  // columns: it is one blob the app reads whole and never queries into, and a
  // new preference is then a schema change rather than a migration.
  editorPreferences Json?

  // Upload rate limit overrides, shaped by `uploadPreferencesSchema`. Same
  // reasoning as above, and null means the account has never changed them.
  uploadPreferences Json?

  // AI settings, shaped by `aiPreferencesSchema`. Same reasoning again, and
  // null means the account has never changed them — which reads as AI on.
  aiPreferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  items       Item[]
  itemTypes   ItemType[]
  collections Collection[]
  tags        Tag[]
}

model ItemType {
  id       String  @id @default(cuid())
  name     String
  slug     String // URL segment used by /items/[type]
  icon     String // lucide-react icon name
  color    String // hex value
  isSystem Boolean @default(false)

  userId String? // null for system types
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items                 Item[]
  defaultForCollections Collection[]

  // Postgres treats NULLs as distinct, so this only constrains custom types.
  // System type names are kept unique by the seed.
  @@unique([userId, name])
  @@unique([userId, slug])
  @@index([userId])
}

model Item {
  id          String      @id @default(cuid())
  title       String
  contentType ContentType

  content  String? @db.Text // text content (snippet/prompt/note/command)
  fileUrl  String? // Cloudflare R2 object key, not a URL — `uploads/{userId}/…`
  fileName String? // original filename
  fileSize Int? // bytes
  url      String? // for link type

  description String?
  language    String? // optional, code syntax highlighting hint
  author      String? // book only, like language: written for the type that owns it

  isFavorite Boolean @default(false)
  isPinned   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemTypeId String
  itemType   ItemType @relation(fields: [itemTypeId], references: [id])

  tags        Tag[]
  collections ItemCollection[]
  explanation ItemExplanation?

  @@index([userId])
  @@index([itemTypeId])
  @@index([userId, isFavorite])
  @@index([userId, isPinned])
  @@index([userId, updatedAt])
}

/// A cached AI explanation of one item's code.
///
/// Its own model rather than columns on `Item`: `itemSelect` is shared by every
/// dashboard, list and search query, and a `@db.Text` blob on `Item` is one
/// careless `select` away from being shipped to the browser for every row.
model ItemExplanation {
  id String @id @default(cuid())

  /// One explanation per item — a newer one replaces it rather than joining it.
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  explanation String @db.Text

  /// A digest of exactly what was sent to the model, so the cache is discarded
  /// when the code changes and kept when anything else about the item does.
  /// Deliberately not `Item.updatedAt`, which Prisma bumps on every write —
  /// favouriting or pinning would otherwise throw away a paid-for answer.
  sourceHash String

  /// The model that wrote it. A hit requires a match, so changing models does
  /// not keep serving answers the new one never produced.
  model String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          String  @id @default(cuid())
  name        String
  description String?
  isFavorite  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultTypeId String?
  defaultType   ItemType? @relation(fields: [defaultTypeId], references: [id])

  items ItemCollection[]

  @@index([userId])
  @@index([userId, isFavorite])
  @@index([defaultTypeId])
}

model ItemCollection {
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([itemId, collectionId])
  @@index([collectionId])
}

model Tag {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]

  @@unique([userId, name])
}
