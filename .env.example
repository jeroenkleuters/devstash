# Copy to .env.local and fill in with your Neon branch connection strings.

# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/devstash?sslmode=require"

# Direct connection (no "-pooler") — used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/devstash?sslmode=require"

# Optional: only if `prisma migrate dev` cannot create its own shadow database.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/devstash_shadow?sslmode=require"

# NextAuth v5. Generate the secret with `npx auth secret`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub OAuth app — https://github.com/settings/developers
# Homepage URL:    http://localhost:3000
# Callback URL:    http://localhost:3000/api/auth/callback/github

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Sender for verification emails. `onboarding@resend.dev` needs no domain setup
# but only delivers to the address that owns the Resend account; anything else
# requires a domain verified at https://resend.com/domains.
RESEND_FROM="DevStash <onboarding@resend.dev>"

# Origin the verification and password-reset links point at. Required in
# production, where an unset value throws rather than falling back: the fallback
# is the request's own origin, which Next derives from the caller's Host header,
# so a spoofed one would aim a real user's reset link at someone else's domain.
# Optional in development, where the fallback keeps things working unconfigured.
APP_URL="http://localhost:3000"

# Whether a new email/password account must confirm its address before signing
# in. On unless explicitly switched off, so an incomplete environment keeps the
# requirement. Set to `false` while RESEND_FROM is still `onboarding@resend.dev`,
# which only delivers to the Resend account owner — registering any other
# address would otherwise create an account that can never be verified.
# Accounts registered while this is off are stored as already-verified, so
# turning it back on does not lock them out.
EMAIL_VERIFICATION_ENABLED=true


# Upstash Redis — https://console.upstash.com/redis — backs the rate limits on
# the auth endpoints. Both are required for limiting to run at all: with either
# missing the limiter fails open and logs, so the app still works unconfigured
# but the endpoints are unguarded.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Storage
#
# Uploads go straight from the browser to the bucket over a presigned PUT, so
# the bucket needs a CORS policy or those requests are blocked before they are
# sent. Set it on the bucket (R2 > Settings > CORS policy):
#
#   [
#     {
#       "AllowedOrigins": ["http://localhost:3000", "https://your-domain"],
#       "AllowedMethods": ["PUT"],
#       "AllowedHeaders": ["Content-Type"],
#       "MaxAgeSeconds": 3600
#     }
#   ]
#
# Without it the upload fails with an opaque network error that looks like a bug
# in the app rather than a missing setting.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Unused: nothing needs a public URL, since files are served through
# /api/items/[id]/file and the object key is what is stored.
R2_PUBLIC_URL=""   

# Stripe - https://dashboard.stripe.com/apikeys
#
# The secret key is server-only and must never reach a bundle. Test-mode keys
# (sk_test_...) are what belongs in a development environment; this file is
# documentation, so every value here stays empty.
STRIPE_SECRET_KEY=""

# Unused: checkout runs entirely server-side as a redirect to a hosted Checkout
# Session, so no page loads Stripe.js and nothing reads a publishable key. Kept
# as a marker rather than dropped, since a subscription integration with no
# publishable key in sight reads as an omission.
STRIPE_PUBLISHABLE_KEY=""

# Signing secret for POST /api/webhooks/stripe. Required - the handler refuses
# every request without it, because an unverified webhook is a request from
# anyone claiming to be Stripe, and what it claims is that an account is now
# Pro. Comes from `stripe listen` locally, or from the endpoint's own page in
# the dashboard for a deployment; the two are different values.
STRIPE_WEBHOOK_SECRET=""

# The recurring prices Pro is sold at ($8/mo, $72/yr). A request names a plan
# and the server resolves it to one of these, so nobody can subscribe
# themselves to a price the app does not offer.
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Note: APP_URL above becomes strictly required once billing is wired up.
# Checkout's return URLs are built from it and must never fall back to the
# request's Host header - see configuredOrigin() in src/lib/app-url.ts.

# ---------------------------------------------------------------- AI features

# Key for the OpenAI API, used by every AI feature (gpt-5-nano). Read lazily,
# so the app builds and runs without it - the features refuse and log rather
# than the process failing to start. Must be set in the Vercel project
# environment too: .env.production is gitignored and Vercel never sees it,
# which the Stripe keys already had to learn.
OPENAI_API_KEY=""

# The monthly ceiling on AI spend across the whole app, in dollars. Global
# rather than per-account on purpose: the point is that the owner's bill is
# bounded, and a per-account cap does nothing about fifty accounts spending a
# dollar each. An env var so it can change without a deploy; unset or
# unparseable falls back to 5, never to unlimited.
#
# It is the second line of defence, not the guarantee. The ledger lives in the
# same Upstash Redis the rate limiter uses, so with Redis unreachable the spend
# is unknown and AI refuses - unlike the rate limiter, this one fails CLOSED.
# The control that actually stops the money is the budget limit set in the
# OpenAI dashboard, because it is enforced on their side of the wire.
AI_MONTHLY_BUDGET_USD=""
